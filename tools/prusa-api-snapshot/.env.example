# Copier vers `.env` et renseigner les secrets localement (ne jamais commiter `.env`).

# --- PrusaLink (LAN, HTTP Digest) ---
# Secret : la « API Key » affichée dans PrusaLink / imprimante (utilisée comme mot de passe digest avec PRUSALINK_USER).
PRUSALINK_ENABLED=false
PRUSALINK_BASE_URL=http://192.168.1.42
PRUSALINK_USER=maker
PRUSALINK_API_KEY=
# Ancien nom supporté par le script si PRUSALINK_API_KEY est vide :
# PRUSALINK_PASSWORD=

# Rare : certains builds utilisent Basic à la place de Digest
PRUSALINK_BASIC_AUTH=false

# Limite le nombre de fichiers G-code pour lesquels on télécharge le détail (méta complète)
PRUSALINK_MAX_PRINT_FILE_SAMPLES=80

# --- Prusa Connect (API mobile `connect-mobile-api.prusa3d.com`) ---
# Jeton : clé API Connect ou JWT de session — envoyé tel quel dans `Authorization: Bearer …` (spec OpenAPI `client_jwt_token`).
PRUSA_CONNECT_ENABLED=false
PRUSA_CONNECT_BASE_URL=https://connect-mobile-api.prusa3d.com
PRUSA_CONNECT_API_KEY=
# Ancien nom supporté si PRUSA_CONNECT_API_KEY est vide :
# PRUSA_CONNECT_BEARER_TOKEN=

# Pagination (jobs / imprimantes)
PRUSA_CONNECT_ITEMS_PER_PAGE=30
PRUSA_CONNECT_MAX_PAGES=100

# Sortie (chemin absolu ou relatif au répertoire courant au lancement)
# OUTPUT_PATH=./out/prusa-snapshot.json
